# Configurações do Datarum API
# Este arquivo é OPCIONAL - as configurações principais estão em config.py

# Ambiente (development/production)
ENVIRONMENT=development

# Debug (true/false)  
DEBUG=true

# Nível de log (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# URLs permitidas para CORS (separadas por vírgula)
# Para desenvolvimento, localhost já está configurado
# Para produção, edite config.py diretamente
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Limites de arquivos
MAX_FILE_SIZE_MB=10
MAX_FILES_COUNT=20

# IMPORTANTE:
# Para mudanças reais de configuração, edite o arquivo config.py
# Este .env é mantido apenas para compatibilidade com o script run.py

# Métricas
ENABLE_METRICS=true
METRICS_PORT=9090

# Cache (para desenvolvimento, deixar false)
ENABLE_CACHE=false
CACHE_TTL=3600

# Configurações específicas para produção
# Descomente e ajuste quando necessário:

# Para produção:
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=WARNING
# MAX_CONCURRENT_REQUESTS=50
# RATE_LIMIT_PER_MINUTE=100
# ENABLE_CACHE=true
# CORS_ORIGINS=https://datarum.com.br,https://app.datarum.com.br
