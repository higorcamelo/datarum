# Configurações do Frontend Sigonota - ARQUIVO DE EXEMPLO  
# Copie este arquivo para .env e ajuste os valores conforme necessário

# === BACKEND API ===
VITE_API_URL=http://127.0.0.1:8000

# === LIMITES DE UPLOAD ===
VITE_MAX_FILES=200
VITE_MAX_FILE_SIZE_MB=5

# === RECURSOS GRATUITOS ===
VITE_LIMITE_XMLS_MENSAL=750

# === FUNCIONALIDADES ===
VITE_ENABLE_PRESETS=true
VITE_ENABLE_CUSTOM_FIELDS=true
VITE_ENABLE_EXCEL_OPTIONS=true

# === DESENVOLVIMENTO ===
VITE_DEBUG=false
VITE_LOG_LEVEL=info

# === INFORMAÇÕES DA APLICAÇÃO ===
VITE_APP_VERSION=1.1.0
