{
  "version": 2,
  "builds": [
    {
      "src": "frontend/sigonota-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/sigonota-frontend/$1"
    }
  ],
  "outputDirectory": "frontend/sigonota-frontend/dist",
  "framework": "vite", 
  "env": {
    "VITE_API_URL": "https://datarum-api.fly.dev"
  }
}
